# Copy to `.env` beside docker-compose.yml and fill in. `.env` is gitignored and
# must stay that way — everything below is a credential.
#
# Generate the three passwords rather than inventing them:
#   openssl rand -base64 24
#
# Nothing here has a default in application-prod.properties on purpose. A
# missing variable fails the context at startup naming what is missing, which is
# what you want: the alternative is an instance that starts happily and connects
# somewhere with a guessed password.

# ── Where the API answers ────────────────────────────────────────────────
# The hostname Caddy requests a certificate for. It must already resolve to
# this machine's public IP before the stack starts, or Let's Encrypt's HTTP-01
# challenge fails and Caddy retries into a rate limit.
GASTA_DOMAIN=gasta.duckdns.org

# Let's Encrypt emails this address before a certificate expires. A real
# address — it is the only warning you get if renewal breaks.
GASTA_ACME_EMAIL=you@example.com

# ── MySQL ────────────────────────────────────────────────────────────────
# The root password is used by the container's own healthcheck and for
# administration. The application never uses it: it connects as MYSQL_USER,
# which the image grants rights on MYSQL_DATABASE and nothing else.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=gasta
MYSQL_USER=gasta
MYSQL_PASSWORD=

# ── Redis ────────────────────────────────────────────────────────────────
# Redis holds the OTP hashes and the rate-limit counters. It publishes no port
# and is only reachable on the internal Docker network, so this is the second
# lock rather than the first — but "unreachable" and "unauthenticated" are
# different guarantees and only one of them survives somebody adding a `ports:`
# line in a hurry.
REDIS_PASSWORD=

# ── DuckDNS ──────────────────────────────────────────────────────────────
# Just the label, not the full name: `gasta`, not `gasta.duckdns.org`.
DUCKDNS_SUBDOMAIN=gasta
# From the top of duckdns.org once you are signed in. This one IS a secret —
# it can repoint your domain at anybody's server.
DUCKDNS_TOKEN=

# ── Image tag ────────────────────────────────────────────────────────────
# `latest` while deploys are manual. Once GitHub Actions builds these, set it
# to the commit sha so a rollback is `GASTA_TAG=<previous> docker compose up -d`
# rather than a rebuild.
GASTA_TAG=latest
